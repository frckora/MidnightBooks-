# Telegram Bot API token — configure as a server secret, never commit the real value.
TELEGRAM_BOT_TOKEN=

# Private Telegram supergroup ID used as the storage container.
TELEGRAM_STORAGE_CHAT_ID=

# Comma-separated Telegram numeric user IDs allowed to administer the catalogue.
ADMIN_TELEGRAM_USER_IDS=

# Public HTTPS origin of the deployed Mini App (used for CORS allow-listing).
MINI_APP_ORIGIN=https://frckora.github.io

# Technical index connection. This stores pointers/indexes only, not book content.
# Set only after selecting and provisioning the index provider.
INDEX_DATABASE_URL=
